APP_ENV=development
APP_NAME="Shopify Job Tracker API"
APP_VERSION=0.1.0
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

CORS_ORIGINS=*

# Async driver — use the `postgresql+asyncpg://` scheme.
# Local docker-compose:  postgresql+asyncpg://sjt:sjt@postgres:5432/shopify_job_tracker
# Local standalone:      postgresql+asyncpg://postgres:postgres@localhost:5432/shopify_job_tracker
DATABASE_URL=postgresql+asyncpg://sjt:sjt@localhost:5432/shopify_job_tracker

DATABASE_URL_SYNC=postgresql+psycopg://sjt:sjt@localhost:5432/shopify_job_tracker

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_ECHO=false

JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

RAPIDAPI_KEY=
JSEARCH_HOST=jsearch.p.rapidapi.com

SCRAPE_CRON_HOURS=2
SCRAPE_ON_STARTUP=false
