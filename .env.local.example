# ── Main FastAPI backend ─────────────────────────────────────────────────────
# NEXT_PUBLIC_* is inlined for the browser — used as the upstream API origin for
# SSR and as the rewrite target if API_INTERNAL_URL is unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: where Next.js should proxy `/upstream-api/*`
# (e.g. Docker service `http://backend:8000`). Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://localhost:8000

# Public job-board URL (used for "View live board" links)
NEXT_PUBLIC_USER_APP_URL=http://localhost:3000

# Required for GET /api/v1/jobs, /api/v1/stats, etc. (X-API-Key header).
# Must match the dashboard API key configured on the backend server.
NEXT_PUBLIC_DASHBOARD_API_KEY=

# ── Job Scraper service ──────────────────────────────────────────────────────
# URL of the standalone Node.js scraper server that exposes /api/jobs/...
# Used by the Administrator Controls page (Scrapers) in the admin dashboard.
NEXT_PUBLIC_SCRAPER_API_URL=http://172.20.1.108:3000

# Optional: server-side proxy URL for the scraper service
# (e.g. Docker service `http://scraper:3000`). Defaults to NEXT_PUBLIC_SCRAPER_API_URL.
SCRAPER_INTERNAL_URL=http://172.20.1.108:3000
