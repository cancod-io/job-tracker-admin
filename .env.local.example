# Server-side upstream for Next Route Handlers (/upstream-api, /upstream-admin-api).
# Local: API on this machine
API_INTERNAL_URL=http://localhost:8000
# Docker on VPS (API on host): use http://host.docker.internal:8000
# (docker-compose sets extra_hosts for host.docker.internal)

# Browser-facing API hint (timeouts/errors only — fetches use same-origin proxy)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USER_APP_URL=http://localhost:3000
