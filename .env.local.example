# NEXT_PUBLIC_* is inlined for the browser — used as the upstream API origin for SSR and as the rewrite target if API_INTERNAL_URL is unset.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: where Next.js should proxy `/upstream-api/*` (e.g. Docker service `http://backend:8000`). Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_USER_APP_URL=http://localhost:3000

# Required for GET /api/v1/jobs, /api/v1/stats, etc. (X-API-Key). Must match server dashboard key configuration.
NEXT_PUBLIC_DASHBOARD_API_KEY=
