[Unit]
Description=Job Tracker admin deploy webhook listener (port 8084)
After=network.target docker.service
Requires=docker.service

[Service]
WorkingDirectory=/opt/job-tracker-admin
EnvironmentFile=/opt/job-tracker-admin/.env
ExecStart=/usr/bin/python3 /opt/job-tracker-admin/scripts/webhook_listener.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
